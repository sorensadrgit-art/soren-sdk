{
  "name": "soren-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-native SDK intelligence, policy, routing, and verification platform.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @soren-sdk/contracts build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @soren-sdk/contracts typecheck",
    "test": "pnpm --filter @soren-sdk/contracts test",
    "validate:repository": "pnpm --filter @soren-sdk/contracts validate:repository",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:repository"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
