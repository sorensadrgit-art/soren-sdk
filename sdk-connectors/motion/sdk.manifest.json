  "capabilityClaims": [
    {
      "capability": "motion.presence",
      "support": "primary",
      "confidence": 1,
      "conditions": [
        "React 18.2 or newer",
        "Component mount or unmount state owns the animation lifecycle"
      ],
      "limitations": [
        "Not intended for framework-independent timeline choreography"
      ]
    },
    {
      "capability": "motion.layout",
      "support": "primary",
      "confidence": 1,
      "conditions": [
        "React 18.2 or newer",
        "Layout projection is appropriate for the requested transition"
      ],
      "limitations": [
        "Explicit property ownership is required when combined with another animation provider"
      ]
    },
    {
      "capability": "motion.shared-layout",
      "support": "primary",
      "confidence": 1,
      "conditions": [
        "React 18.2 or newer",
        "Shared layout identity is stable across the transition"
      ],
      "limitations": [
        "Requires coordinated React layout identity"
      ]
    },
    {
      "capability": "motion.spring",
      "support": "primary",
      "confidence": 0.98,
      "conditions": [
        "React 18.2 or newer"
      ],
      "limitations": [
        "Simple self-contained transitions should remain native when a spring is not required"
      ]
    },
    {
      "capability": "interaction.drag",
      "support": "primary",
      "confidence": 1,
      "conditions": [
        "React 18.2 or newer",
        "Pointer-driven direct manipulation is required"
      ],
      "limitations": [
        "Advanced non-React drag systems are outside this claim"
      ]
    },
    {
      "capability": "interaction.gesture",
      "support": "primary",
      "confidence": 0.98,
      "conditions": [
        "React 18.2 or newer"
      ],
      "limitations": [
        "Does not claim complex scroll choreography"
      ]
    }
  ],
