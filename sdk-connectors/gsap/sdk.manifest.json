  "capabilityClaims": [
    {
      "capability": "motion.timeline",
      "support": "primary",
      "confidence": 1,
      "conditions": [
        "The request requires sequenced or overlapping imperative choreography"
      ],
      "limitations": [
        "Simple self-contained effects should remain native"
      ]
    },
    {
      "capability": "motion.svg",
      "support": "primary",
      "confidence": 0.98,
      "conditions": [
        "SVG drawing, morphing, or coordinated SVG choreography is required"
      ],
      "limitations": [
        "Required plugins must be present in the approved runtime artifact"
      ]
    },
    {
      "capability": "motion.flip",
      "support": "primary",
      "confidence": 0.98,
      "conditions": [
        "FLIP-based state transition is required"
      ],
      "limitations": [
        "Explicit layout and property ownership is required when combined with Motion"
      ]
    },
    {
      "capability": "scroll.triggered-animation",
      "support": "primary",
      "confidence": 1,
      "conditions": [
        "ScrollTrigger-style progress or trigger control is required"
      ],
      "limitations": [
        "Does not claim smooth-scroll transport"
      ]
    },
    {
      "capability": "scroll.pinned-sequence",
      "support": "primary",
      "confidence": 1,
      "conditions": [
        "Pinned scroll-driven storytelling is required"
      ],
      "limitations": [
        "Responsive contexts and pin cleanup must be verified"
      ]
    }
  ],
