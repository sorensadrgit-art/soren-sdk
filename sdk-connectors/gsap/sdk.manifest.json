  "capabilityClaims": [
    {
      "capability": "motion.timeline",
      "support": "primary",
      "confidence": 1,
      "conditions": ["Multi-step imperative choreography is required."],
      "limitations": ["Use native CSS for simple self-contained transitions."]
    },
    {
      "capability": "motion.svg",
      "support": "primary",
      "confidence": 0.98,
      "conditions": ["SVG choreography requires imperative sequencing."],
      "limitations": ["SVG property ownership must be exclusive per scope."]
    },
    {
      "capability": "motion.flip",
      "support": "primary",
      "confidence": 0.98,
      "conditions": ["A FLIP transition is explicitly required."],
      "limitations": ["Do not share layout/transform ownership with Motion on the same scope."]
    },
    {
      "capability": "scroll.triggered-animation",
      "support": "primary",
      "confidence": 1,
      "conditions": ["ScrollTrigger-style choreography is required."],
      "limitations": ["Scroll trigger ownership must be singular per scope."]
    },
    {
      "capability": "scroll.pinned-sequence",
      "support": "primary",
      "confidence": 1,
      "conditions": ["Pinned scroll storytelling is required."],
      "limitations": ["Pinning and cleanup must be tested across breakpoints."]
    }
  ],
  "integrations": [
