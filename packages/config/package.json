{
  "name": "@soren-sdk/config",
  "version": "0.1.0",
  "private": true,
  "description": "Project configuration parsing, policy resolution, and lockfile management for Soren SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@soren-sdk/contracts": "workspace:*",
    "js-yaml": "4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9"
  }
}
