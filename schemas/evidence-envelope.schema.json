{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sorensadrgit-art/soren-sdk/main/schemas/evidence-envelope.schema.json",
  "title": "Soren SDK Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractKind",
    "evidenceId",
    "digest",
    "projectSnapshot",
    "catalogSnapshot",
    "policySnapshot",
    "routePlan",
    "executionPlan",
    "checks",
    "unverified"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0-draft.1" },
    "contractKind": { "const": "evidence-envelope" },
    "evidenceId": { "type": "string", "pattern": "^evidence_[0-9a-f]{24}$" },
    "digest": { "$ref": "#/$defs/digest" },
    "projectSnapshot": { "$ref": "#/$defs/digest" },
    "catalogSnapshot": { "$ref": "#/$defs/digest" },
    "policySnapshot": { "$ref": "#/$defs/digest" },
    "routePlan": { "$ref": "#/$defs/identity" },
    "executionPlan": { "$ref": "#/$defs/identity" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "unverified": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "status", "diagnostics", "artifacts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run",
            "not-required",
            "blocked",
            "cancelled",
            "timed-out",
            "unverified"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" }
        }
      }
    }
  }
}
