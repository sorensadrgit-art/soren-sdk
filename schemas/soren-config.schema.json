{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sorensadrgit-art/soren-sdk/main/schemas/soren-config.schema.json",
  "title": "Soren SDK Project Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractKind",
    "configId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0-draft.1"
    },
    "contractKind": {
      "const": "soren-config"
    },
    "configId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredProviders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbiddenProviders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "maxProviders": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
