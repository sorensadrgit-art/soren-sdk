{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sorensadrgit-art/soren-sdk/main/schemas/route-plan.schema.json",
  "title": "Soren SDK Route Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractKind",
    "planId",
    "createdAt",
    "status",
    "requestId",
    "projectSnapshotId",
    "catalogSnapshotId",
    "policySnapshotId",
    "requestedCapabilities",
    "selectedProviders",
    "rejectedProviders",
    "ownership",
    "constraints",
    "uncertainty",
    "requiredInput",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0-draft.1"
    },
    "contractKind": {
      "const": "route-plan"
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "selected",
        "native",
        "no-sdk",
        "needs-input",
        "blocked"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "projectSnapshotId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "catalogSnapshotId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policySnapshotId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requestedCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "selectedProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "integrationIds",
          "capabilities",
          "reasonCode",
          "reason"
        ],
        "properties": {
          "providerId": {
            "type": "string"
          },
          "integrationIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rejectedProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "reasonCode",
          "reason"
        ],
        "properties": {
          "providerId": {
            "type": "string"
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "domain",
          "scope",
          "properties"
        ],
        "properties": {
          "providerId": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-applicable"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requiredInput": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "native",
              "no-sdk",
              "needs-input",
              "blocked"
            ]
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "selectedProviders": {
            "maxItems": 0,
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "selected"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "selectedProviders": {
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ]
}
