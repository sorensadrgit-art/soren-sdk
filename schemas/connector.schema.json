{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sorensadrgit-art/soren-sdk/main/schemas/connector.schema.json",
  "title": "Soren SDK Connector Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "connectorVersion",
    "connector",
    "product",
    "sourceTrust",
    "capabilityClaims",
    "integrations",
    "ownershipClaims",
    "verification",
    "relatedFiles",
    "knowledge"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": "2.0.0-draft.1"
    },
    "connectorVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "publisher",
        "reviewStatus",
        "selectable",
        "blockers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "reviewStatus": {
          "enum": [
            "proposed",
            "experimental",
            "approved",
            "stable",
            "deprecated",
            "retired",
            "blocked"
          ]
        },
        "selectable": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalName",
        "homepage",
        "aliases",
        "categories"
      ],
      "properties": {
        "canonicalName": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "sourceTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAuthority",
        "integrityLevel",
        "reviewedAt",
        "reviewer"
      ],
      "properties": {
        "sourceAuthority": {
          "enum": [
            "official",
            "maintainer",
            "soren-approved",
            "community",
            "unknown"
          ]
        },
        "integrityLevel": {
          "enum": [
            "unverified",
            "url-recorded",
            "version-pinned",
            "commit-pinned",
            "digest-pinned",
            "signed",
            "attested"
          ]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilityClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "support",
          "confidence",
          "conditions",
          "limitations"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "support": {
            "enum": [
              "primary",
              "secondary",
              "fallback"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "mode",
          "status",
          "source",
          "version",
          "authorization",
          "executionRisk",
          "dataExposure",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "documentation",
              "agent-skill",
              "mcp-server",
              "runtime-package",
              "cli",
              "validator",
              "recipe-source",
              "built-in"
            ]
          },
          "mode": {
            "enum": [
              "knowledge",
              "tool",
              "runtime",
              "verification"
            ]
          },
          "status": {
            "enum": [
              "available",
              "planned",
              "unverified",
              "deprecated"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "not-applicable"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "resolved"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                },
                "then": {
                  "anyOf": [
                    {
                      "required": [
                        "value"
                      ],
                      "properties": {
                        "value": {}
                      },
                      "type": "object"
                    },
                    {
                      "required": [
                        "digest"
                      ],
                      "properties": {
                        "digest": {}
                      },
                      "type": "object"
                    },
                    {
                      "required": [
                        "commit"
                      ],
                      "properties": {
                        "commit": {}
                      },
                      "type": "object"
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not-applicable"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "value"
                        ],
                        "properties": {
                          "value": {}
                        },
                        "type": "object"
                      },
                      {
                        "required": [
                          "digest"
                        ],
                        "properties": {
                          "digest": {}
                        },
                        "type": "object"
                      },
                      {
                        "required": [
                          "commit"
                        ],
                        "properties": {
                          "commit": {}
                        },
                        "type": "object"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "protocol": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "supportedVersions",
              "extensions"
            ],
            "properties": {
              "name": {
                "enum": [
                  "mcp",
                  "http",
                  "stdio",
                  "cli",
                  "none"
                ]
              },
              "supportedVersions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "method",
              "paidPlan"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "method": {
                "enum": [
                  "none",
                  "api-key",
                  "oauth",
                  "environment",
                  "project-config",
                  "unknown"
                ]
              },
              "paidPlan": {
                "type": "boolean"
              }
            }
          },
          "executionRisk": {
            "enum": [
              "none",
              "read-only",
              "project-write",
              "command-execution",
              "network-and-command",
              "privileged"
            ]
          },
          "dataExposure": {
            "enum": [
              "none",
              "local-only",
              "remote-metadata",
              "remote-source",
              "remote-project-content"
            ]
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filesystem",
              "network",
              "projectWrite"
            ],
            "properties": {
              "filesystem": {
                "enum": [
                  "none",
                  "project-read",
                  "project-write",
                  "scoped",
                  "unknown"
                ]
              },
              "network": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "projectWrite": {
                "type": "boolean"
              }
            }
          },
          "licenseExpression": {
            "type": "string",
            "minLength": 1
          },
          "fallback": {
            "type": [
              "string",
              "null"
            ]
          },
          "packageName": {
            "type": "string"
          },
          "importPaths": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "runtime-package"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "required": [
                "packageName",
                "licenseExpression"
              ],
              "properties": {
                "packageName": {},
                "licenseExpression": {}
              },
              "type": "object"
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "mcp-server"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "required": [
                "protocol",
                "licenseExpression"
              ],
              "properties": {
                "protocol": {
                  "properties": {
                    "name": {
                      "const": "mcp"
                    }
                  },
                  "type": "object"
                },
                "licenseExpression": {}
              },
              "type": "object"
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "agent-skill"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "required": [
                "licenseExpression"
              ],
              "properties": {
                "licenseExpression": {}
              },
              "type": "object"
            }
          }
        ]
      }
    },
    "ownershipClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "scope",
          "exclusive"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "exclusive": {
            "type": "boolean"
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredChecks",
        "hardGates"
      ],
      "properties": {
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hardGates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "relatedFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "sources",
        "compatibility",
        "evaluations"
      ],
      "properties": {
        "skill": {
          "$ref": "#/$defs/fileStatus"
        },
        "sources": {
          "$ref": "#/$defs/fileStatus"
        },
        "compatibility": {
          "$ref": "#/$defs/fileStatus"
        },
        "evaluations": {
          "$ref": "#/$defs/fileStatus"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrievedAt",
        "staleAfterDays"
      ],
      "properties": {
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "staleAfterDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "fileStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "present",
            "planned",
            "missing",
            "not-applicable"
          ]
        }
      }
    }
  }
}
