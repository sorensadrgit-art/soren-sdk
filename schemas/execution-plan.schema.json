{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sorensadrgit-art/soren-sdk/main/schemas/execution-plan.schema.json",
  "title": "Soren SDK Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractKind",
    "executionPlanId",
    "createdAt",
    "routePlanId",
    "mode",
    "immutableDigest",
    "fileChanges",
    "dependencyChanges",
    "commands",
    "networkDestinations",
    "credentials",
    "rollback",
    "verification",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0-draft.1"
    },
    "contractKind": {
      "const": "execution-plan"
    },
    "executionPlanId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "routePlanId": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "plan",
        "apply"
      ]
    },
    "immutableDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fileChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "path",
          "contentDigest"
        ],
        "properties": {
          "operation": {
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "path": {
            "type": "string"
          },
          "contentDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "dependencyChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "workspace",
          "package",
          "version",
          "kind",
          "reason"
        ],
        "properties": {
          "operation": {
            "enum": [
              "add",
              "remove",
              "update"
            ]
          },
          "workspace": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "dependency",
              "devDependency",
              "peerDependency",
              "optionalDependency"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "cwd",
          "timeoutSeconds",
          "networkRequired"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "networkRequired": {
            "type": "boolean"
          }
        }
      }
    },
    "networkDestinations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "scopes"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "items": {
            "enum": [
              "project-write",
              "command-execution",
              "network",
              "credential-use",
              "release"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "apply"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
