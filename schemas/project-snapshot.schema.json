{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sorensadrgit-art/soren-sdk/main/schemas/project-snapshot.schema.json",
  "title": "Soren SDK Project Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractKind",
    "snapshotId",
    "createdAt",
    "root",
    "revision",
    "packageManager",
    "workspace",
    "runtimes",
    "frameworks",
    "dependencies",
    "configurations",
    "policies",
    "targets",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0-draft.1"
    },
    "contractKind": {
      "const": "project-snapshot"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcs",
        "commit",
        "dirty"
      ],
      "properties": {
        "vcs": {
          "enum": [
            "git",
            "none",
            "unknown"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "packageManager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "lockfile",
        "lockfileDigest"
      ],
      "properties": {
        "name": {
          "enum": [
            "pnpm",
            "npm",
            "yarn",
            "bun",
            "unknown"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "lockfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "lockfileDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isMonorepo",
        "packages"
      ],
      "properties": {
        "isMonorepo": {
          "type": "boolean"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "private"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "private": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "workspace"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "kind",
          "workspace"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "dependency",
              "devDependency",
              "peerDependency",
              "optionalDependency"
            ]
          },
          "workspace": {
            "type": "string"
          }
        }
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "digest"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browsers",
        "runtimes"
      ],
      "properties": {
        "browsers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
